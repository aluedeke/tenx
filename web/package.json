{
  "name": "tenx-web",
  "private": true,
  "version": "0.0.0",
  "description": "The tenx column as a web page beside an xterm.js terminal, served by `tenx web`.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "palette": "node scripts/palette.mjs",
    "predev": "node scripts/palette.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/palette.mjs",
    "build": "next build",
    "lint": "tsc --noEmit",
    "mock": "node tests/mock-server.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
